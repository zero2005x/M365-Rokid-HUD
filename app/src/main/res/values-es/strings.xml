    <string name="experimental_disable">Desactivar y desconectar</string>
    <string name="experimental_command_confirmation">Comando experimental, no verificado en un vehículo. Confirma esta única operación. No se reintentará automáticamente. La relectura informa del valor observado del registro; no certifica seguridad ni compatibilidad.</string>
